#!/usr/bin/env python3
"""HID daemon for Elgato Stream Deck hardware on Noctalia v5."""
from __future__ import annotations

import argparse, ctypes, hashlib, ipaddress, json, os, pathlib, re, shutil, signal, socket, subprocess, sys, tempfile, time, urllib.error, urllib.request

VID = 0x0FD9
PLUS, PEDAL = 0x0084, 0x0086
ORIGINAL = 0x0060
CLASSIC_JPEG_PIDS = (0x006D, 0x0080, 0x00A5, 0x00B9)


def _classic_jpeg(name: str) -> dict:
    return {
        "kind": "classic",
        "family": "classic",
        "name": name,
        "keys": 15,
        "cols": 5,
        "rows": 3,
        "key_px": 72,
        "image": "jpeg",
        "rotate": 180,
        "origin_flip": False,
        "report": 1024,
        "header": 8,
        "feature_len": 32,
        "capabilities": ["keys", "brightness"],
        "status_key": "classic",
    }


