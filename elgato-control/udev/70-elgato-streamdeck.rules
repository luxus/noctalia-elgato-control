# Elgato Stream Deck family (VID 0fd9) — hidraw + USB access for the plugin daemon.
# Filename must sort before systemd 73-seat-late.rules so TAG+="uaccess" applies.
# NixOS services.udev.extraRules writes 99-local.rules (too late for uaccess).
# This flake's nixosModules.default installs these via services.udev.packages.
#
# No GROUP="input": niri users on lea are often not in that group. MODE:="0660"
# forces the mode; TAG+="uaccess" grants the seated session ACL.
# Do not copy GROUP="input" from luxusAi #143's inlined extraRules.

KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", TAG+="uaccess", MODE:="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", TAG+="uaccess", MODE:="0660"
